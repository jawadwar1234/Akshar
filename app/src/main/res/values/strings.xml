    <!-- DPDP Act 2023 Consent & Onboarding -->
    <string name="consent_title">Welcome to Akshar</string>
    <string name="consent_subtitle">A gentle, private reading companion for your child.</string>
    <string name="consent_privacy_heading">Our Privacy &amp; Data Promise</string>
    <string name="consent_bullet_1">All textbook scanning, text reading, and practice stay on your phone.</string>
    <string name="consent_bullet_2">No ads, no behavior tracking, and no third-party data selling ever.</string>
    <string name="consent_bullet_3">Account sync with cloud storage is optional and protected under your parent account.</string>
    <string name="consent_bullet_4">In accordance with India\'s DPDP Act 2023, you have complete ownership to view, export, or delete all data anytime.</string>
    <string name="consent_checkbox">As a parent, guardian, or teacher, I consent to using Akshar for educational reading support.</string>
