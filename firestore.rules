rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User root document and sub-collections
    match /users/{userId} {
      // Allow read and write only if the authenticated user matches the userId
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Child Profiles sub-collection
      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Scanned Documents sub-collection
        match /documents/{documentId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Word Mastery sub-collection
        match /word_mastery/{wordId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: false;
    }
  }
}
