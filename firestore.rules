rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Top-level users collection: only the authenticated user can read or write their own documents & subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Profiles subcollection
      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Documents subcollection under profile
        match /documents/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Settings subcollection under profile
        match /settings/{settingId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Reading sessions subcollection under profile
        match /sessions/{sessionId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Practice words / mastery subcollection under profile
        match /practiceWords/{wordId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Catch-all recursive matching for any nested subcollections under user subtree
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: false;
    }
  }
}
